{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "rootDir": ".",
        "outDir": "./dist",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowUnusedLabels": false,
        "noUncheckedSideEffectImports": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "noUncheckedIndexedAccess": true,
        "noPropertyAccessFromIndexSignature": true,
        "paths": {
            "@/*": ["./src/*"],
            "@cmp/*": ["./src/cmp/*"],
            "@esri/calcite-components/dist/components/calcite-icon/interfaces": [
                "./node_modules/@esri/calcite-components/dist/components/calcite-icon/interfaces.d.ts"
            ],
            "@esri/calcite-components/dist/components/calcite-button/interfaces": [
                "./node_modules/@esri/calcite-components/dist/components/calcite-button/interfaces.d.ts"
            ],
            "@esri/calcite-components/dist/components/interfaces": [
                "./node_modules/@esri/calcite-components/dist/components/interfaces.d.ts"
            ]
        },
    },
    "include": ["./src", "./tests"],
    "exclude": ["./node_modules"]
}